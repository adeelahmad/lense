{
  "manifest_version": 3,
  "name": "Lens Web Clipper",
  "short_name": "Lens Clipper",
  "description": "Clip pages, selections or any part of a page into your Lens as Markdown, with its metadata and images.",
  "version": "0.0.0",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Clip to Lens",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+L" }, "description": "Open the clipper" },
    "clip-page": { "suggested_key": { "default": "Alt+Shift+P" }, "description": "Clip this page to Lens" },
    "clip-selection": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Clip the selection to Lens" },
    "pick": { "suggested_key": { "default": "Alt+Shift+K" }, "description": "Pick part of the page to clip" }
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
