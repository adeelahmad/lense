{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "clipper",
  "projectType": "application",
  "sourceRoot": "extensions/browser/src",
  "tags": ["lang:javascript"],
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "[ node_modules/.package-lock.json -nt package-lock.json ] || npm ci --include=dev --no-audit --no-fund"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "npm test"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "inputs": ["default", { "env": "EXT_VERSION" }],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "npm run check"
      }
    }
  }
}
