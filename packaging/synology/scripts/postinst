#!/bin/sh
# Writes the Container Manager project (compose/compose.yaml) from its template. Runs as the package user after
# every install and upgrade; Container Manager then loads the bundled images and starts the project.
set -e

PKG=/var/packages/${SYNOPKG_PKGNAME:-lens}
TARGET=${SYNOPKG_PKGDEST:-$PKG/target}
SHARE=$PKG/shares/lens
DATA=$(readlink -f "$SHARE" 2>/dev/null || true)
if [ -z "$DATA" ] || [ ! -d "$DATA" ]; then
    echo "The shared folder \"lens\" is missing. Create it in Control Panel > Shared Folder and install again." >> "${SYNOPKG_TEMP_LOGFILE:-/dev/stderr}"
    exit 1
fi
mkdir -p "$DATA/db" "$DATA/archive" "$DATA/audio/podcasts" "$DATA/audio/interviews"

# Secrets and settings live next to the data they protect, so reinstalling the package keeps sessions, the
# database password and stored credentials working. Values are generated once and never overwritten.
CONF=$DATA/lens.conf
touch "$CONF"
chmod 600 "$CONF"
get() { sed -n "s/^$1=//p" "$CONF" | tail -n 1; }
put() { grep -v "^$1=" "$CONF" > "$CONF.tmp" || true; printf '%s=%s\n' "$1" "$2" >> "$CONF.tmp"; mv "$CONF.tmp" "$CONF"; chmod 600 "$CONF"; }
secret() { head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'; }

for key in ACCESS_SECRET_KEY ARCHIVE_SECRET_KEY AUTH_SECRET SURREAL_PASS; do
    [ -n "$(get "$key")" ] || put "$key" "$(secret)"
done
# The install wizard's answers; an upgrade has none and keeps the stored ones.
[ -n "$wizard_port" ] && put PORT "$wizard_port"
[ -n "$wizard_setup_code" ] && put SETUP_CODE "$wizard_setup_code"
[ -n "${wizard_url+x}" ] && put URL "${wizard_url%/}"
# Mail, for password resets and share links: optional, so only the answers given are stored.
[ -n "$wizard_mail_server" ] && put MAIL_SERVER "$wizard_mail_server"
[ -n "$wizard_mail_port" ] && put MAIL_PORT "$wizard_mail_port"
[ -n "$wizard_mail_username" ] && put MAIL_USERNAME "$wizard_mail_username"
[ -n "$wizard_mail_password" ] && put MAIL_PASSWORD "$wizard_mail_password"
[ -n "$wizard_mail_from" ] && put MAIL_FROM "$wizard_mail_from"
[ -n "$(get PORT)" ] || put PORT 3000
[ -n "$(get SETUP_CODE)" ] || put SETUP_CODE "$(secret | cut -c1-12)"

PORT=$(get PORT)
URL=$(get URL)
if [ -z "$URL" ]; then
    IP=$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p')
    URL="http://${IP:-$(hostname)}:$PORT"
fi
HOST=$(echo "$URL" | sed 's#^[a-z]*://##; s#[:/].*##')

render() {
    sed -e "s#@VERSION@#${SYNOPKG_PKGVER}#g" \
        -e "s#@DATA@#$DATA#g" \
        -e "s#@PORT@#$PORT#g" \
        -e "s#@URL@#$URL#g" \
        -e "s#@HOST@#$HOST#g" \
        -e "s#@SETUP_CODE@#$(get SETUP_CODE)#g" \
        -e "s#@ACCESS_SECRET_KEY@#$(get ACCESS_SECRET_KEY)#g" \
        -e "s#@ARCHIVE_SECRET_KEY@#$(get ARCHIVE_SECRET_KEY)#g" \
        -e "s#@AUTH_SECRET@#$(get AUTH_SECRET)#g" \
        -e "s#@SURREAL_PASS@#$(get SURREAL_PASS)#g" \
        "$1" > "$2"
}
render "$TARGET/compose/compose.yaml.in" "$TARGET/compose/compose.yaml"
chmod 600 "$TARGET/compose/compose.yaml"
render "$TARGET/ui/config.in" "$TARGET/ui/config"
# Every MAIL_* and LENS_* line in lens.conf reaches the API and the worker as it is (LENS_ADMIN_EMAIL, LENS_NAMESPACE,
# LENS_LLM_BASE_URL and the rest of docs/configuration.md); add one there and install the package again to apply it.
grep -E '^(MAIL|LENS)_[A-Z0-9_]+=' "$CONF" > "$TARGET/compose/lens.env" || true
chmod 600 "$TARGET/compose/lens.env"
exit 0
