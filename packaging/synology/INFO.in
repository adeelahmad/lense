package="lens"
version="@VERSION@"
os_min_ver="7.2-69057"
arch="@ARCH@"
displayname="Lens"
description="Lens: transcribe, search and ask questions about your recordings and documents. Runs in Container Manager; everything it needs is inside the package."
maintainer="Adeel Ahmad"
maintainer_url="https://github.com/adeelahmad/lense"
support_url="https://github.com/adeelahmad/lense/issues"
thirdparty="yes"
install_dep_packages="ContainerManager>=20.10.23-1432"
startable="yes"
ctl_stop="yes"
dsmuidir="ui"
dsmappname="com.lens.app"
silent_upgrade="no"
