  "/api/v1/instance-operations/launch": {
   "post": {
    "operationId": "launchInstance",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "properties": {
         "file_system_mounts": {
          "items": {
           "$ref": "#/components/schemas/RequestedFilesystemMountEntry"
          },
          "type": "array"
         },
         "file_system_names": {
          "items": {
           "type": "string"
          },
