# --- Required ---
# Signs access tokens and media links. Generate one with: openssl rand -hex 32
ACCESS_SECRET_KEY=change-me-to-a-long-random-string

# --- Database: SurrealDB ---
# Unset: embedded SurrealDB under data_dir (one process at a time). Set a ws:// URL to share a server.
SURREAL_URL=ws://localhost:8000
SURREAL_USER=root
SURREAL_PASS=root
# SURREAL_NS=archive
# SURREAL_DB=main
# SURREAL_POOL_SIZE=8

# Encrypts credentials stored in the database (storage sources, LLM keys). Keep it stable.
# Unset: a key is generated once in data_dir/secret.key
# ARCHIVE_SECRET_KEY=another-long-random-string

# Processing configuration (namespaces, engines). See archive.example.yaml.
ARCHIVE_CONFIG=archive.yaml

# Run job workers and folder watching inside the API process (default: follow workers.inline in archive.yaml).
# Set to false when a separate `lens worker` process does the work.
# RUN_BACKGROUND=true

# Break-glass override of the allowed Host headers if a bad setting locks you out
# ARCHIVE_ALLOWED_HOSTS=127.0.0.1,localhost

# OpenAPI schema output for the frontend's typed client
OPENAPI_OUTPUT_FILE=../nextjs-frontend/openapi.json

# --- Email (password reset). Unset MAIL_SERVER: reset links are written to the log instead. ---
MAIL_USERNAME=test
MAIL_PASSWORD=test
MAIL_FROM=lens@example.com
MAIL_PORT=1025
MAIL_SERVER=localhost
MAIL_STARTTLS=False
MAIL_SSL_TLS=False
USE_CREDENTIALS=False

# --- Frontend (Next.js) ---
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# --- First run (docs/configuration.md#first-run-setup). Without these, the web app's setup wizard asks. ---
# LENS_SETUP_CODE=choose-one            # the first admin's one-time setup code (default: random, in the log)
# LENS_ADMIN_EMAIL=you@example.com      # create the first admin at startup (with LENS_ADMIN_PASSWORD)
# LENS_ADMIN_PASSWORD=
# LENS_NAMESPACE=archive                # create the first namespace at startup
# LENS_LLM_BASE_URL=http://localhost:11434/v1   # the model provider; these win over Settings and show locked
# LENS_LLM_MODEL=llama3.1
# LENS_LLM_API_KEY=
# LENS_SETUP_WIZARD=off                 # never show the wizard

# --- Telemetry (docs/telemetry.md): off unless turned on here or in Settings, and sent only to this endpoint ---
# LENS_TELEMETRY=on                     # on, or off to keep it off whatever Settings say
# LENS_TELEMETRY_ENDPOINT=http://localhost:4318   # your OpenTelemetry collector's OTLP/HTTP address
# LENS_TELEMETRY_HEADERS=               # optional: key=value pairs, comma-separated, URL-encoded

# Uncomment to disable /docs and /openapi.json
# OPENAPI_URL=""
