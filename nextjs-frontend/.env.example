# FastAPI backend, as seen from the Next.js server (docker: http://backend:8000).
# Also the target of the /api/v1, /embed, /iiif, /reports and /static rewrites,
# which are fixed when `next dev` starts or at `next build`.
API_BASE_URL=http://localhost:8000

# Auth.js: encrypts the session cookie. Generate with `openssl rand -base64 32`.
AUTH_SECRET=change-me
# Trust the Host / X-Forwarded-* headers (needed behind docker or a reverse proxy).
AUTH_TRUST_HOST=true
# Pass a reverse proxy's X-Forwarded-Host / -Proto on to the API (OAuth discovery names that address).
# Leave off unless a proxy in front of this app sets them: browsers could otherwise choose them.
# TRUST_PROXY_HEADERS=true
# The public URL of this app; only needed when it can't be inferred from the request.
# AUTH_URL=http://localhost:3000

# OpenAPI schema the client is generated from (relative to this directory).
OPENAPI_OUTPUT_FILE=openapi.json
